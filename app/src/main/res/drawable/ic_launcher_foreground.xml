<?xml version="1.0" encoding="utf-8"?>
<!-- Navi Moto icon: the round handlebar display with the road ahead and the rider's arrow,
     the same scene the watch shows in route mode. Was a watch (strap + hands) until the
     rename - it is a navigation device now. Kept inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- display bezel -->
    <path
        android:pathData="M26,54 A28,28 0 1 1 82,54 A28,28 0 1 1 26,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5" />
    <!-- road ahead, bending right -->
    <path
        android:pathData="M54,62 L54,47 Q54,40 62,39"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- rider arrow, in the watch UI's amber accent -->
    <path
        android:pathData="M54,50 L63.5,73 L54,66.5 L44.5,73 Z"
        android:fillColor="#FFC24D" />
</vector>
